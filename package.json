{
  "name": "cachewise-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter cachewise build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter cachewise test",
    "test:coverage": "pnpm --filter cachewise test:coverage",
    "check:package": "pnpm --filter cachewise check:package",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm check:package",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.39.0",
    "eslint-plugin-svelte": "^3.13.0",
    "fast-check": "^4.3.0",
    "globals": "^17.13.0",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "publint": "^0.3.15",
    "@arethetypeswrong/cli": "^0.18.2",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@changesets/cli": "^2.29.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,svelte,json,md,yml,yaml,css}": "prettier --write",
    "*.{ts,tsx,js,mjs,cjs}": "eslint --fix"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  }
}
